[Unit]
Description=Matrix Controller Daemon
Documentation=file:///usr/share/doc/matrix-controller/README.md
After=network.target
Wants=network.target
# Don't restart-loop forever if something is fundamentally broken — give up after
# 10 restarts in 5 minutes. systemd surfaces "failed" state, the hardware
# watchdog still keeps the OS alive, and a human can intervene.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# Type=notify lets the daemon send sd_notify("READY=1") and periodic
# WATCHDOG=1 heartbeats. systemd kills + restarts the daemon if no
# heartbeat arrives within WatchdogSec — covers hangs, not just crashes.
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/usr/bin/python3 -m controller.main --config /etc/matrix-controller/controller.yaml
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=matrix-controller

# Run as root to access GPIO and systemctl
User=root
Group=root

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Allow systemctl commands and shutdown
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_BOOT
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_BOOT

# Resource caps — controller is tiny; if it ever blows up, kill it fast.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
